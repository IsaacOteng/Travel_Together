DEBUG=False
SECRET_KEY=replace-with-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1

# HTTPS-only hardening (SSL redirect, HSTS, secure cookies).
# Turn on ONLY where TLS actually terminates. Leaving it false lets DEBUG=False
# run safely over plain http locally, instead of redirect-looping to https.
ENABLE_HTTPS_SECURITY=False

# Believe the X-Forwarded-For header when identifying a caller's IP.
# Turn on ONLY when a reverse proxy you control sets it. Off, the per-IP OTP
# rate limit uses REMOTE_ADDR (unforgeable); on without a proxy in front, any
# client can spoof the header and walk straight through that limit.
TRUST_PROXY_HEADERS=False

# PostgreSQL + PostGIS
DATABASE_URL=postgis://postgres:yourpassword@localhost:5432/travel_together

# Redis (leave blank to use in-memory channel layer for dev)
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=60
# Rolling: each refresh mints a fresh 60-day token, so this is "log in again
# after 60 days without opening the app", not 60 days after signing in.

# Seconds a just-rotated refresh token still answers with the pair it was
# swapped for. Absorbs the browser refreshing from several tabs/requests at
# once; set to 0 for strict single-use rotation.
JWT_REFRESH_REPLAY_GRACE_SECONDS=60

# Email
# Local dev: console backend prints emails to the terminal.
# Production: switch to smtp and fill in Brevo credentials.
#   Sign up at brevo.com → SMTP & API → SMTP tab → copy the SMTP key as EMAIL_HOST_PASSWORD.
#   EMAIL_HOST_USER is your Brevo login email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google OAuth (for social-auth, separate from Firebase)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Firebase Admin SDK paste the full service-account JSON as a single line
FIREBASE_SERVICE_ACCOUNT_JSON=

# GeoDjango Windows only (remove on Linux/Mac)
GDAL_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgdal-35.dll
GEOS_LIBRARY_PATH=C:\Program Files\PostgreSQL\16\bin\libgeos_c.dll

# Cloudflare R2 object storage
# Local dev: leave USE_R2=False files are saved to the local media/ folder.
# Production: set USE_R2=True and fill in the four values below.
#   dash.cloudflare.com → R2 → create bucket → Manage R2 API tokens → create token (Object Read & Write)
#   R2_ENDPOINT_URL format: https://<account_id>.r2.cloudflarestorage.com
#   R2_PUBLIC_DOMAIN: optional custom domain (e.g. media.traveltogether.app)
USE_R2=False
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_PUBLIC_DOMAIN=

# Africa's Talking SMS (optional)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER=TravelTogether
